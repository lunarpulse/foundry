+    let claim = store
+        .reserve_code_change(service, "w3-input", "w3-op")
+        .unwrap();
+    assert_eq!(
+        store
+            .reserved_code_change_task(service, &claim, "w3-op")
+            .unwrap(),
+        f.task()
+    );
+    assert!(
+        store
+            .reserved_code_change_task(service, &claim, "other-op")
+            .is_err()
+    );
+    store
+        .mark_code_change_uncertain(service, "w3-input", "w3-op")
+        .unwrap();
+    assert!(
+        store
+            .reserved_code_change_task(service, &claim, "w3-op")
+            .is_err()
+    );
+}
diff --git a/crates/foundry/src/isolation.rs b/crates/foundry/src/isolation.rs
new file mode 100644
index 0000000..defa680
--- /dev/null
+++ b/crates/foundry/src/isolation.rs
@@ -0,0 +1,330 @@
+//! Product pack stages cross this port only with a durable host intent and journal run.
+#[cfg(feature = "product-pack-pins")]
+pub(crate) mod dispatch;
+mod listener;
+
+use foundry_exec::{ExecutionIntent, ReviewInputManifest, ReviewRedriveArtifact};
+use foundry_line::{StageExecutor, StageOutput, StageTask};
+use rand_core::{OsRng, RngCore};
+use serde::{Deserialize, Serialize};
+use serde_json::{Value, json};
+use sha2::{Digest, Sha256};
+use std::{
+    collections::BTreeMap,
+    fs,
+    io::{Read, Write},
+    os::unix::fs::DirBuilderExt,
+    path::{Path, PathBuf},
+    process::{Command, Stdio},
+    time::{Duration, Instant},
+};
+
+const LAUNCHER: &str = concat!(
+    include_str!("../../../deploy/profile.py"),
+    "\n",
+    include_str!("../../../deploy/launcher.py")
+);
+const PROFILE: &str = include_str!("../../../deploy/compose.yaml");
+
+pub(super) struct ProductLauncher {
+    image: String,
+    repo: PathBuf,
+    artifacts: PathBuf,
+    cache: PathBuf,
+    timeout: Duration,
+    inspection_only: bool,
+    producer_task: Option<String>,
+    deadline: Option<chrono::DateTime<chrono::Utc>>,
+}
+
+fn reject() -> String {
+    "product isolation configuration or evidence rejected".into()
+}
+
+impl ProductLauncher {
+    pub fn configured(
+        artifacts: &Path,
+        sessions: &Path,
+        inspection_only: bool,
+    ) -> Result<Self, String> {
+        let image = std::env::var("FOUNDRY_W3_IMAGE").map_err(|_| reject())?;
+        if !image.strip_prefix("sha256:").is_some_and(|s| {
+            s.len() == 64
+                && s.bytes()
+                    .all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b))
+        }) {
+            return Err(reject());
+        }
+        let repo = PathBuf::from(std::env::var_os("FOUNDRY_REPO_PATH").ok_or_else(reject)?)
+            .canonicalize()
+            .map_err(|_| reject())?;
+        Ok(Self {
+            image,
+            repo,
+            artifacts: artifacts.to_owned(),
+            cache: sessions.join("w3-objects"),
+            timeout: Duration::from_secs(foundry_line::DieStageExecutor::configured_timeout()?),
+            inspection_only,
+            producer_task: None,
+            deadline: None,
+        })
+    }
+
+    fn inputs(
+        &self,
+        task: &StageTask,
+    ) -> Result<(BTreeMap<String, String>, BTreeMap<String, Vec<u8>>), String> {
+        let root = self.artifacts.canonicalize().map_err(|_| reject())?;
+        let mut files = BTreeMap::new();
+        let mut total = 0;
+        let mut materialize = |name: &str| -> Result<String, String> {
+            let path = Path::new(name).canonicalize().map_err(|_| reject())?;
+            if !path.starts_with(&root)
+                || path.file_name().and_then(|s| s.to_str()) != Some("accepted-output")
+            {
+                return Err(reject());
+            }
+            let mut bytes = Vec::new();
+            fs::File::open(path)
+                .and_then(|f| f.take(1_048_577).read_to_end(&mut bytes))
+                .map_err(|_| reject())?;
+            total += bytes.len();
+            if bytes.len() > 1_048_576 || total > 2_097_152 {
+                return Err(reject());
+            }
+            let local = format!("input-{}", files.len());
+            files.insert(local.clone(), bytes);
+            Ok(format!("/work/{local}"))
+        };
+        let mut inputs = BTreeMap::new();
+        for (key, val) in &task.inputs {
+            let mapped = if task.fix_context.is_some() {
+                let mut rows: Vec<ReviewRedriveArtifact> =
+                    serde_json::from_str(val).map_err(|_| reject())?;
+                for row in &mut rows {
+                    row.log_path = materialize(&row.log_path)?;
+                }
+                serde_json::to_string(&rows).map_err(|_| reject())?
+            } else {
+                materialize(val)?
+            };
+            inputs.insert(key.clone(), mapped);
+        }
+        Ok((inputs, files))
+    }
+}
+
+#[derive(Serialize, Deserialize)]
+struct StageSession {
+    manifest: ReviewInputManifest,
+    output: Value,
+}
+
+impl ProductLauncher {
+    fn session_file(&self, order: &str, id: &str) -> PathBuf {
+        let key =
+            Sha256::digest(serde_json::to_vec(&(&self.image, order, id)).expect("string tuple"));
+        self.cache.join("sessions").join(hex::encode(key))
+    }
+
+    fn previous(&self, order: &str, id: &str) -> Result<Option<StageSession>, String> {
+        match fs::read(self.session_file(order, id)) {
+            Ok(bytes) => serde_json::from_slice(&bytes)
+                .map(Some)
+                .map_err(|_| reject()),
+            Err(e) if e.kind() == std::io::ErrorKind::NotFound => Ok(None),
+            Err(_) => Err(reject()),
+        }
+    }
+
+    fn save_session(
+        &self,
+        order: &str,
+        id: &str,
+        manifest: ReviewInputManifest,
+        bytes: &[u8],
+    ) -> Result<(), String> {
+        let dst = self.session_file(order, id);
+        let parent = dst.parent().ok_or_else(reject)?;
+        fs::create_dir_all(parent).map_err(|_| reject())?;
+        let mut nonce = [0; 16];
+        OsRng.try_fill_bytes(&mut nonce).map_err(|_| reject())?;
+        let tmp = parent.join(hex::encode(nonce));
+        let mut file = fs::File::create_new(&tmp).map_err(|_| reject())?;
+        let output = serde_json::from_slice(bytes).map_err(|_| reject())?;
+        serde_json::to_writer(&mut file, &StageSession { manifest, output })
+            .map_err(|_| reject())?;
+        file.sync_all()
+            .and_then(|_| fs::rename(&tmp, dst))
+            .map_err(|_| reject())
+    }
+}
+
+struct SocketDir(PathBuf);
+impl SocketDir {
+    fn new() -> Result<Self, String> {
+        let mut random = [0; 16];
+        OsRng.try_fill_bytes(&mut random).map_err(|_| reject())?;
+        let path = PathBuf::from("/tmp").join(format!("foundry-w3-{}", hex::encode(random)));
+        fs::DirBuilder::new()
+            .mode(0o700)
+            .create(&path)
+            .map_err(|_| reject())?;
+        Ok(Self(path))
+    }
+}
+impl Drop for SocketDir {
+    fn drop(&mut self) {
+        let _ = fs::remove_dir(&self.0);
+    }
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct DieOutput {
+    findings: bool,
+    verdict_category: Option<String>,
+    #[serde(default)]
+    verdict_categories: Vec<String>,
+    inspected_commit: Option<String>,
+    produced_commit: Option<String>,
+}
+
+impl StageExecutor for ProductLauncher {
+    fn ensure_available(&self) -> Result<(), String> {
+        let status = Command::new("/usr/bin/timeout")
+            .args([
+                "5",
+                "/usr/bin/docker",
+                "--host",
+                "unix:///var/run/docker.sock",
+                "image",
+                "inspect",
+                "--format",
+                "{{.Id}}",
+            ])
+            .arg(&self.image)
+            .env_clear()
+            .env("HOME", "/nonexistent")
+            .env("PATH", "/usr/bin:/bin")
+            .output()
+            .map_err(|_| reject())?;
+        if !status.status.success() || status.stdout != format!("{}\n", self.image).as_bytes() {
+            return Err(reject());
+        }
+        Ok(())
+    }
+
+    fn restore_session_for_order(
+        &mut self,
+        order: &str,
+        id: &str,
+        _workdir: &Path,
+    ) -> Result<(), String> {
+        self.previous(order, id)?.ok_or_else(reject)?;
+        Ok(())
+    }
+
+    fn execute(&mut self, _: &StageTask) -> Result<StageOutput, String> {
+        Err("product execution requires a bound journal run".into())
+    }
+
+    fn execute_in_run(
+        &mut self,
+        intent: &ExecutionIntent,
+        journal: &str,
+        task: &StageTask,
+    ) -> Result<StageOutput, String> {
+        let inspect = matches!(task.role.as_str(), "verify" | "lens");
+        if journal.is_empty()
+            || (!inspect
+                && (self.inspection_only
+                    || !matches!(
+                        task.role.as_str(),
+                        "producer" | "implement" | "fix" | "replan"
+                    )))
+        {
+            return Err(reject());
+        }
+        self.ensure_available()?;
+        let timeout = match self.deadline {
+            Some(deadline) => self.timeout.min(
+                (deadline - chrono::Utc::now())
+                    .to_std()
+                    .map_err(|_| reject())?,
+            ),
+            None => self.timeout,
+        };
+        if timeout.as_secs() == 0 {
+            return Err(reject());
+        }
+        let (inputs, files) = self.inputs(task)?;
+        let scope = vec![
+            intent.order.0.clone(),
+            intent.epoch.0.to_string(),
+            journal.to_owned(),
+        ];
+        let dir = SocketDir::new()?;
+        let listener = listener::Listener::offline(
+            dir.0.join("model.sock"),
+            journal,
+            &scope,
+            Instant::now() + timeout,
+        )
+        .map_err(|_| reject())?;
+        let previous = self.previous(&intent.order.0, &task.session_id)?;
+        let mut manifest = ReviewInputManifest {
+            order_id: task.session_id.clone(),
+            attempt: 0,
+            task: format!("{}:{}", task.role, task.stage_id),
+            profile: "coding".into(),
+            base: task.base_commit.clone(),
+            fix_context: task.fix_context.is_some(),
+            context: inputs.iter().map(|(k, v)| format!("{k}={v}")).collect(),
+        };
+        if let Some(saved) = &previous {
+            manifest
+                .context
+                .push(format!("previous_task={}", saved.manifest.task));
+            manifest
+                .context
+                .push("previous_die_output=/work/.die-session/die-output.json".into());
+        }
+        let image_files = json!({
+            "worker.py":hex::encode(Sha256::digest(include_bytes!("../../../deploy/worker.py"))),
+            "model-client":hex::encode(Sha256::digest(include_bytes!("../../../deploy/model-client.py"))),
+        });
+        let spec = json!({"image_files":image_files,"workdir":task.workdir,"cache":self.cache,"repo":self.repo,"image":self.image,
+            "profile":serde_json::from_str::<Value>(PROFILE).map_err(|_|reject())?, "socket":listener.path,
+            "intent":intent,"run":journal,"order":intent.order.0,"provider":"none","budget_scope":scope,"token":listener.token,
+            "timeout":timeout.as_secs(),"lease_end_ms":self.deadline.map(|t|t.timestamp_millis()),"task":self.producer_task,"inputs":files, "manifest":manifest,"previous":previous,
+            "stage":{"version":1,"role":task.role,"stage_id":task.stage_id,"artifact_commit":task.artifact_commit,
+            "lens_bytes":task.lens_bytes,"inputs":inputs}});
+        let mut child = Command::new("/usr/bin/python3")
+            .args(["-I", "-c", LAUNCHER])
+            .env_clear()
+            .stdin(Stdio::piped())
+            .stdout(Stdio::piped())
+            .spawn()
+            .map_err(|_| reject())?;
+        let sent = serde_json::to_writer(child.stdin.take().ok_or_else(reject)?, &spec);
+        let output = child.wait_with_output().map_err(|_| reject())?;
+        if sent.is_err() || !output.status.success() || output.stdout.len() > 1_048_576 {
+            return Err(reject());
+        }
+        let result: DieOutput = serde_json::from_slice(&output.stdout).map_err(|_| reject())?;
+        let path = task.workdir.join("die-output.json");
+        fs::File::create_new(&path)
+            .and_then(|mut f| f.write_all(&output.stdout))
+            .map_err(|_| reject())?;
+        self.save_session(&intent.order.0, &task.session_id, manifest, &output.stdout)?;
+        Ok(StageOutput {
+            log_path: path.to_string_lossy().into_owned(),
+            findings: result.findings,
+            verdict_category: result.verdict_category,
+            verdict_categories: result.verdict_categories,
+            produced_commit: result.produced_commit,
+            inspected_commit: result.inspected_commit,
+        })
+    }
+}
diff --git a/crates/foundry/src/isolation/dispatch.rs b/crates/foundry/src/isolation/dispatch.rs
new file mode 100644
index 0000000..bd23b14
--- /dev/null
+++ b/crates/foundry/src/isolation/dispatch.rs
@@ -0,0 +1,288 @@
+//! Explicit product requests. Executable work needs a fresh decision from the
+//! task's original owner naming this image and the exact W2 receipt.
+use super::ProductLauncher;
+use crate::selected_review::{Database, dispatch_bound, registry, require_local_commit};
+use axum::{
+    Json, Router,
+    extract::{DefaultBodyLimit, State},
+    http::{HeaderMap, StatusCode},
+    routing::post,
+};
+use foundry_ledger::{
+    ProductServiceAction, ProductServiceContext, ProductStore, product::CommitReviewRequest,
+};
+use foundry_line::{StageExecutor, StageTask};
+use serde::Deserialize;
+use serde_json::{Value, json};
+use sha2::{Digest, Sha256};
+use std::{collections::BTreeMap, fs, path::PathBuf};
+
+#[derive(Deserialize)]
+#[serde(tag = "action", deny_unknown_fields, rename_all = "kebab-case")]
+enum Operation {
+    Review {
+        commit: String,
+        selection_revision: i64,
+    },
+    Produce {
+        task_sha256: String,
+        image: String,
+    },
+}
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Request {
+    order: String,
+    lifecycle: i64,
+    admission_hash: String,
+    request_key: String,
+    connector: String,
+    repository_id: String,
+    api_origin: String,
+    operation: Operation,
+}
+
+pub(crate) fn router(db: PathBuf, installation_id: String, database_id: String) -> Router {
+    Router::new()
+        .route("/api/product/execution", post(execute))
+        .layer(DefaultBodyLimit::max(8192))
+        .with_state(Database {
+            db,
+            installation_id,
+            database_id,
+        })
+}
+
+async fn execute(
+    State(db): State<Database>,
+    headers: HeaderMap,
+    Json(req): Json<Request>,
+) -> Result<(StatusCode, Json<Value>), StatusCode> {
+    let owner = headers
+        .get("authorization")
+        .and_then(|v| v.to_str().ok())
+        .and_then(|s| s.strip_prefix("Bearer "))
+        .filter(|s| !s.is_empty())
+        .ok_or(StatusCode::UNAUTHORIZED)?;
+    let session = hex::encode(Sha256::digest(owner.as_bytes()));
+    let token = headers
+        .get("x-foundry-service")
+        .and_then(|v| v.to_str().ok())
+        .filter(|s| !s.is_empty())
+        .ok_or(StatusCode::UNAUTHORIZED)?
+        .to_owned();
+    tokio::task::spawn_blocking(move || {
+        let store = db.open()?;
+        if !store.scope_policy_enforced().map_err(|_| ())? {
+            return Err(());
+        }
+        let service = store
+            .authenticate_product_service_for_action(
+                &token,
+                &req.connector,
+                &req.api_origin,
+                &req.repository_id,
+                ProductServiceAction::DriveReview,
+                chrono::Utc::now(),
+            )
+            .map_err(|_| ())?;
+        drop(token);
+        if std::env::var("FOUNDRY_PRODUCT_REVIEW_SOURCE")
+            .ok()
+            .as_deref()
+            != Some(service.source_instance_id())
+        {
+            return Err(());
+        }
+        match &req.operation {
+            Operation::Review {
+                commit,
+                selection_revision,
+            } => dispatch_bound(
+                &db,
+                store,
+                &session,
+                &service,
+                CommitReviewRequest {
+                    order: &req.order,
+                    lifecycle: req.lifecycle,
+                    admission_hash: &req.admission_hash,
+                    commit,
+                    selection_revision: *selection_revision,
+                    request_key: &req.request_key,
+                },
+            ),
+            Operation::Produce { task_sha256, image } => {
+                produce(store, &session, &service, &req, task_sha256, image)
+            }
+        }
+    })
+    .await
+    .map_err(|_| StatusCode::INTERNAL_SERVER_ERROR)?
+    .map(|value| {
+        let status = match value.get("state").and_then(Value::as_str) {
+            Some("uncertain" | "reserved" | "sealed") => StatusCode::CONFLICT,
+            _ => StatusCode::OK,
+        };
+        (status, Json(value))
+    })
+    .map_err(|_| StatusCode::FORBIDDEN)
+}
+
+fn produce(
+    mut store: ProductStore,
+    session: &str,
+    service: &ProductServiceContext,
+    req: &Request,
+    task_sha: &str,
+    image: &str,
+) -> Result<Value, ()> {
+    let receipt = store
+        .code_change_for_producer(service, &req.order)
+        .map_err(|_| ())?;
+    if receipt.lifecycle != req.lifecycle
+        || receipt.admission_hash != req.admission_hash
+        || receipt.task_sha256 != task_sha
+        || req.request_key.is_empty()
+    {
+        return Err(());
+    }
+    // Replaying the exact immutable receipt requires the original live owner,
+    // task grant, source, selection and approval revisions.
+    let fresh = store
+        .authorize_code_change(
+            session,
+            &req.order,
+            req.lifecycle,
+            &req.admission_hash,
+            task_sha,
+            &receipt.request_key,
+        )
+        .map_err(|_| ())?;
+    if fresh != receipt {
+        return Err(());
+    }
+    let decision = json!(["isolated-produce-v1", receipt, image, req.request_key]);
+    let key = format!(
+        "w3-{:x}",
+        Sha256::digest(serde_json::to_vec(&decision).map_err(|_| ())?)
+    );
+    if let Ok(existing) = store.code_change_status(service, &req.order, &key) {
+        return serde_json::to_value(existing).map_err(|_| ());
+    }
+    let artifacts = PathBuf::from(std::env::var_os("FOUNDRY_PRODUCT_ARTIFACT_ROOT").ok_or(())?);
+    let sessions = PathBuf::from(std::env::var_os("FOUNDRY_PRODUCT_SESSION_ROOT").ok_or(())?);
+    let mut launcher = ProductLauncher::configured(&artifacts, &sessions, false).map_err(|_| ())?;
+    if launcher.image != image {
+        return Err(());
+    }
+    launcher.ensure_available().map_err(|_| ())?;
+    require_local_commit(&receipt.base_commit)?;
+    let configured = registry()?;
+    if !configured.snapshots.contains_key(&receipt.pack_digest) {
+        return Err(());
+    }
+    store = store.with_product_registry(configured);
+    let claim = store
+        .reserve_code_change(service, &req.order, &key)
+        .map_err(|_| ())?;
+    let run: Result<(), ()> = (|| {
+        let dir = artifacts.join("w3-producers").join(&key);
+        fs::create_dir_all(dir.parent().ok_or(())?).map_err(|_| ())?;
+        fs::create_dir(&dir).map_err(|_| ())?;
+        fs::write(
+            dir.join("decision.json"),
+            serde_json::to_vec(&decision).map_err(|_| ())?,
+        )
+        .map_err(|_| ())?;
+        launcher.producer_task = Some(
+            store
+                .reserved_code_change_task(service, &claim, &key)
+                .map_err(|_| ())?,
+        );
+        launcher.deadline = Some(claim.lease_until());
+        let fence = claim.review_binding().fence;
+        let intent = foundry_exec::ExecutionIntent {
+            order: foundry_exec::OrderId(req.order.clone()),
+            attempt: foundry_exec::Attempt(1),
+            run: foundry_exec::RunId(1),
+            activation: 1,
+            generation: foundry_exec::Generation(0),
+            epoch: foundry_exec::Epoch(fence as u64),
+            recorded_at: chrono::Utc::now(),
+            external_ref: key.clone(),
+        };
+        let stage = StageTask {
+            stage_id: "authorized-producer".into(),
+            role: "producer".into(),
+            session_id: key.clone(),
+            fix_context: None,
+            base_commit: receipt.base_commit.clone(),
+            artifact_commit: receipt.base_commit.clone(),
+            lens_bytes: vec![],
+            inputs: BTreeMap::new(),
+            workdir: dir.clone(),
+        };
+        store
+            .validate_product_work_claim(&claim, chrono::Utc::now())
+            .map_err(|_| ())?;
+        let output = launcher
+            .execute_in_run(&intent, &key, &stage)
+            .map_err(|_| ())?;
+        let head = output.produced_commit.ok_or(())?;
+        let sealed = store
+            .seal_code_change(service, &req.order, &key, &dir.join("objects.git"), &head)
+            .map_err(|_| ())?;
+        let patch = fs::read(dir.join("collected.patch")).map_err(|_| ())?;
+        if sealed.artifact_sha256.as_deref() != Some(&format!("{:x}", Sha256::digest(patch))) {
+            return Err(());
+        }
+        store
+            .collect_code_change(service, &req.order, &key)
+            .map_err(|_| ())?;
+        Ok(())
+    })();
+    let status = if run.is_ok() {
+        store.code_change_status(service, &req.order, &key)
+    } else {
+        store.mark_code_change_uncertain(service, &req.order, &key)
+    }
+    .map_err(|_| ())?;
+    serde_json::to_value(status).map_err(|_| ())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[tokio::test]
+    async fn execution_requires_both_credentials_and_fixed_request_shape() {
+        let root = std::env::temp_dir().join("unused-w3-execution-store");
+        let db = Database {
+            db: root.clone(),
+            installation_id: "fixture".into(),
+            database_id: "fixture".into(),
+        };
+        let body = json!({"order":"fixture","lifecycle":1,"admission_hash":"fixture","request_key":"fixture",
+            "api_origin":"https://api.github.com","connector":"github-primary","repository_id":"repo:1",
+            "operation":{"action":"produce","task_sha256":"fixture","image":"fixture"}});
+        let mut injected = body.clone();
+        injected["operation"]["argv"] = json!(["forbidden"]);
+        assert!(serde_json::from_value::<Request>(injected).is_err());
+        for (name, value) in [
+            ("authorization", "Bearer fixture"),
+            ("x-foundry-service", "fixture"),
+        ] {
+            let mut headers = HeaderMap::new();
+            headers.insert(name, value.parse().unwrap());
+            let result = execute(
+                State(db.clone()),
+                headers,
+                Json(serde_json::from_value(body.clone()).unwrap()),
+            )
+            .await;
+            assert_eq!(result.unwrap_err(), StatusCode::UNAUTHORIZED);
+        }
+        assert!(!root.exists());
+    }
+}
diff --git a/crates/foundry/src/isolation/listener.rs b/crates/foundry/src/isolation/listener.rs
new file mode 100644
index 0000000..e665984
--- /dev/null
+++ b/crates/foundry/src/isolation/listener.rs
@@ -0,0 +1,355 @@
+//! One stage, one short-lived socket and one controller-issued capability.
+//! Frames are a big-endian u32 length followed by UTF-8 JSON.
+use foundry_watch::model_proxy::{ModelProxy, ProviderEndpoint, ProxyRequest};
+use rand_core::{OsRng, RngCore};
+use serde::Deserialize;
+use serde_json::{Value, json};
+use sha2::{Digest, Sha256};
+use std::{
+    fs,
+    io::{self, Read, Write},
+    os::unix::{
+        fs::PermissionsExt,
+        net::{UnixListener, UnixStream},
+    },
+    path::{Path, PathBuf},
+    sync::{
+        Arc,
+        atomic::{AtomicBool, Ordering},
+    },
+    thread,
+    time::{Duration, Instant},
+};
+
+const MAX: usize = 256 * 1024;
+
+fn rejected() -> io::Error {
+    io::Error::other("proxy operation rejected")
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Envelope {
+    token: String,
+    request: ProxyRequest,
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct ProviderReply {
+    status: u16,
+    body: String,
+}
+
+struct Grant {
+    token_hash: [u8; 32],
+    run: String,
+    provider: String,
+    scope: Vec<String>,
+    remaining: u32,
+    deadline: Instant,
+    upstream: PathBuf,
+}
+
+fn read_frame(stream: &mut UnixStream, deadline: Instant, limit: usize) -> io::Result<Vec<u8>> {
+    fn exact(s: &mut UnixStream, mut dst: &mut [u8], until: Instant) -> io::Result<()> {
+        while !dst.is_empty() {
+            s.set_read_timeout(Some(
+                until
+                    .checked_duration_since(Instant::now())
+                    .ok_or_else(rejected)?,
+            ))?;
+            let n = s.read(dst)?;
+            if n == 0 {
+                return Err(rejected());
+            }
+            dst = &mut dst[n..];
+        }
+        Ok(())
+    }
+    let mut size = [0; 4];
+    exact(stream, &mut size, deadline)?;
+    let n = u32::from_be_bytes(size) as usize;
+    if n > limit {
+        return Err(rejected());
+    }
+    let mut data = vec![0; n];
+    exact(stream, &mut data, deadline)?;
+    Ok(data)
+}
+
+fn write_frame(stream: &mut UnixStream, v: &Value) -> io::Result<()> {
+    let bytes = serde_json::to_vec(v)?;
+    if bytes.len() > MAX {
+        return Err(rejected());
+    }
+    stream.set_write_timeout(Some(Duration::from_secs(1)))?;
+    stream.write_all(&(bytes.len() as u32).to_be_bytes())?;
+    stream.write_all(&bytes)
+}
+
+impl Grant {
+    fn reserve(&mut self, wire: &[u8], policy: &ModelProxy) -> io::Result<(ProxyRequest, usize)> {
+        let envelope: Envelope = serde_json::from_slice(wire)?;
+        let req = envelope.request;
+        let hash: [u8; 32] = Sha256::digest(envelope.token.as_bytes()).into();
+        if hash != self.token_hash
+            || req.run != self.run
+            || req.provider != self.provider
+            || req.budget_scope != self.scope
+            || self.remaining == 0
+            || Instant::now() >= self.deadline
+        {
+            return Err(rejected());
+        }
+        let provider = policy.validate(&req).map_err(|_| rejected())?;
+        let actual = format!("unix://{}", self.upstream.display());
+        policy
+            .screen_egress(&req.provider, &actual)
+            .map_err(|_| rejected())?;
+        // Reserve the call before sending. An uncertain send cannot be retried for free.
+        self.remaining -= 1;
+        Ok((req, provider.max_response_bytes.min(MAX as u64) as usize))
+    }
+
+    fn forward(&mut self, wire: &[u8], policy: &ModelProxy) -> io::Result<Value> {
+        let (req, limit) = self.reserve(wire, policy)?;
+        let until = self.deadline.min(Instant::now() + Duration::from_secs(1));
+        let runtime = tokio::runtime::Builder::new_current_thread()
+            .enable_io()
+            .enable_time()
+            .build()?;
+        let mut upstream = runtime
+            .block_on(async {
+                tokio::time::timeout_at(
+                    until.into(),
+                    tokio::net::UnixStream::connect(&self.upstream),
+                )
+                .await
+                .map_err(|_| rejected())?
+            })?
+            .into_std()?;
+        upstream.set_nonblocking(false)?;
+        let id = policy.request_id(&req);
+        write_frame(&mut upstream, &json!({"request_id":id,"request":req}))?;
+        let raw = read_frame(&mut upstream, until, MAX)?;
+        let reply: ProviderReply = serde_json::from_slice(&raw)?;
+        if !(200..300).contains(&reply.status) || reply.body.len() > limit {
+            return Err(rejected());
+        }
+        let body = reply.body;
+        policy
+            .check_response_size(&req.provider, body.len() as u64)
+            .map_err(|_| rejected())?;
+        Ok(json!({"request_id":id,"body":body,
+                  "run":req.run,"provider":req.provider,"budget_scope":req.budget_scope}))
+    }
+}
+
+pub(super) struct Listener {
+    pub token: String,
+    pub path: PathBuf,
+    stop: Arc<AtomicBool>,
+    thread: Option<thread::JoinHandle<()>>,
+}
+
+impl Listener {
+    pub fn offline(path: PathBuf, run: &str, scope: &[String], until: Instant) -> io::Result<Self> {
+        Self::start(
+            path,
+            run,
+            "none",
+            scope,
+            until,
+            0,
+            Path::new("/run/foundry/providers/none.sock"),
+        )
+    }
+
+    fn start(
+        path: PathBuf,
+        run: &str,
+        provider: &str,
+        scope: &[String],
+        until: Instant,
+        remaining: u32,
+        upstream: &Path,
+    ) -> io::Result<Self> {
+        let mut secret = [0; 32];
+        OsRng.try_fill_bytes(&mut secret).map_err(|_| rejected())?;
+        let token = hex::encode(secret);
+        let mut grant = Grant {
+            token_hash: Sha256::digest(token.as_bytes()).into(),
+            run: run.into(),
+            provider: provider.into(),
+            scope: scope.into(),
+            deadline: until,
+            remaining,
+            upstream: upstream.into(),
+        };
+        let listener = UnixListener::bind(&path)?;
+        // Parent is controller-private. The sole child bind-mounts the socket inode.
+        fs::set_permissions(&path, fs::Permissions::from_mode(0o666))?;
+        listener.set_nonblocking(true)?;
+        let policy = ModelProxy::new(
+            vec![ProviderEndpoint {
+                name: provider.into(),
+                origin: format!("unix://{}", upstream.display()),
+                env_key_name: String::new(),
+                max_response_bytes: 64 * 1024,
+            }],
+            move |_| {
+                if Instant::now() < until {
+                    Ok(())
+                } else {
+                    Err("expired".into())
+                }
+            },
+        );
+        let stop = Arc::new(AtomicBool::new(false));
+        let stopping = stop.clone();
+        let thread = thread::spawn(move || {
+            while !stopping.load(Ordering::Acquire) && Instant::now() < until {
+                match listener.accept() {
+                    Ok((mut client, _)) => {
+                        let deadline = until.min(Instant::now() + Duration::from_secs(1));
+                        let response = read_frame(&mut client, deadline, MAX)
+                            .and_then(|wire| grant.forward(&wire, &policy))
+                            .unwrap_or_else(|_| json!({"error":"denied"}));
+                        let _ = write_frame(&mut client, &response);
+                    }
+                    Err(e) if e.kind() == io::ErrorKind::WouldBlock => {
+                        thread::sleep(Duration::from_millis(5))
+                    }
+                    Err(_) => break,
+                }
+            }
+        });
+        Ok(Self {
+            token,
+            path,
+            stop,
+            thread: Some(thread),
+        })
+    }
+}
+impl Drop for Listener {
+    fn drop(&mut self) {
+        self.stop.store(true, Ordering::Release);
+        if let Some(handle) = self.thread.take() {
+            let _ = handle.join();
+        }
+        let _ = fs::remove_file(&self.path);
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn binding_and_budget_precede_transport() {
+        let until = Instant::now() + Duration::from_secs(30);
+        let scope = vec!["order".into(), "7".into(), "journal".into()];
+        let mut grant = Grant {
+            token_hash: Sha256::digest(b"fixture-token").into(),
+            run: "journal".into(),
+            provider: "fixture".into(),
+            scope: scope.clone(),
+            deadline: until,
+            remaining: 1,
+            upstream: "/fixture.sock".into(),
+        };
+        let policy = ModelProxy::new(
+            vec![ProviderEndpoint {
+                name: "fixture".into(),
+                origin: "unix:///fixture.sock".into(),
+                env_key_name: String::new(),
+                max_response_bytes: 512,
+            }],
+            |_| Ok(()),
+        );
+        let valid = json!({"token":"fixture-token","request":{"run":"journal","provider":"fixture","budget_scope":scope,"body":"test"}});
+        for (field, value) in [
+            ("/token", json!("other")),
+            ("/request/run", json!("other")),
+            ("/request/provider", json!("other")),
+            ("/request/budget_scope", json!([])),
+        ] {
+            let mut bad = valid.clone();
+            *bad.pointer_mut(field).unwrap() = value;
+            assert!(
+                grant
+                    .reserve(&serde_json::to_vec(&bad).unwrap(), &policy)
+                    .is_err()
+            );
+        }
+        let mut extra = valid.clone();
+        extra["request"]["url"] = json!("forbidden");
+        assert!(
+            grant
+                .reserve(&serde_json::to_vec(&extra).unwrap(), &policy)
+                .is_err()
+        );
+        let wire = serde_json::to_vec(&valid).unwrap();
+        assert_eq!(grant.reserve(&wire, &policy).unwrap().1, 512);
+        assert!(grant.reserve(&wire, &policy).is_err());
+    }
+
+    #[test]
+    fn authenticated_listener_uses_bound_test_upstream() {
+        let root = std::env::temp_dir().join(format!("w3-wire-{}", std::process::id()));
+        fs::create_dir(&root).unwrap();
+        let address = root.join("up.sock");
+        let upstream = UnixListener::bind(&address).unwrap();
+        let until = Instant::now() + Duration::from_secs(5);
+        let scope = vec!["fixture-budget".to_owned()];
+        let gate = Listener::start(
+            root.join("model.sock"),
+            "fixture-run",
+            "test",
+            &scope,
+            until,
+            1,
+            &address,
+        )
+        .unwrap();
+        let call = |token: &str, run: &str, provider: &str, scope: &[String]| {
+            let mut client = UnixStream::connect(&gate.path).unwrap();
+            write_frame(&mut client,&json!({"token":token,"request":{"provider":provider,"run":run,"budget_scope":scope,"body":"inert"}})).unwrap();
+            serde_json::from_slice::<Value>(&read_frame(&mut client, until, MAX).unwrap()).unwrap()
+        };
+        for reply in [
+            call("wrong", "fixture-run", "test", &scope),
+            call(&gate.token, "other", "test", &scope),
+            call(&gate.token, "fixture-run", "other", &scope),
+            call(&gate.token, "fixture-run", "test", &[]),
+        ] {
+            assert_eq!(reply, json!({"error":"denied"}));
+        }
+        let server = thread::spawn(move || {
+            upstream.set_nonblocking(true).unwrap();
+            let mut conn = loop {
+                if let Ok((stream, _)) = upstream.accept() {
+                    break stream;
+                }
+                assert!(Instant::now() < until);
+                thread::sleep(Duration::from_millis(5));
+            };
+            let bytes = read_frame(&mut conn, until, MAX).unwrap();
+            let frame: Value = serde_json::from_slice(&bytes).unwrap();
+            assert_eq!(frame["request"]["body"], "inert");
+            write_frame(&mut conn, &json!({"status":200,"body":"test"})).unwrap();
+            frame["request_id"].clone()
+        });
+        let response = call(&gate.token, "fixture-run", "test", &scope);
+        assert_eq!(response["body"], "test");
+        assert_eq!(response["request_id"], server.join().unwrap());
+        assert_eq!(
+            call(&gate.token, "fixture-run", "test", &scope),
+            json!({"error":"denied"})
+        );
+        drop(gate);
+        fs::remove_file(address).unwrap();
+        fs::remove_dir(root).unwrap();
+    }
+}

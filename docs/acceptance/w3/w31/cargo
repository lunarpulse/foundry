#!/usr/bin/env bash
# Run from the worktree root. Each invocation owns its TMPDIR and log.
set -eu
umask 077
log=$1
shift
private=$(mktemp -d /tmp/w31.XXXXXXXX)
trap 'rm -rf -- "$private"' EXIT
export TMPDIR="$private" CARGO_BUILD_JOBS=1 CARGO_INCREMENTAL=0 CARGO_NET_OFFLINE=true
export CARGO_PROFILE_TEST_DEBUG=0 CARGO_PROFILE_DEV_DEBUG=0 CARGO_TARGET_DIR="$PWD/target/w31"
set +e
(
    set -ex
    rustfmt --edition 2024 --check crates/foundry/src/isolation.rs crates/foundry/tests/w2.rs
    git diff --check
    cargo test --locked --offline -j1 "$@"
) >"$log" 2>&1
code=$?
echo "exit=$code" >>"$log"
exit "$code"

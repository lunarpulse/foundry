+#[derive(Args)]
+pub(super) struct ProducerArgs {
+    #[command(flatten)]
+    database: Database,
+    #[command(flatten)]
+    source: Source,
+    #[arg(long,value_parser=["reserve","seal","collect","status","recover"])]
+    action: String,
+    #[arg(long)]
+    order: String,
+    #[arg(long)]
+    request_key: String,
+    #[arg(long, required_if_eq("action", "seal"))]
+    commit: Option<String>,
+}
